{
  "bot_name": "PR Master",
  "persona": "time-t4e",
  "model": "claude-sonnet-5-5",
  "auto_detect_branches": true,
  "main_branch_patterns": [
    "main",
    "master",
    "dev",
    "develop",
    "staging",
    "homolog(acao)?",
    "prod(ucao|uction)?"
  ],
  "integration_branch_priority": [
    "dev",
    "develop",
    "staging",
    "homolog"
  ],
  "max_tokens": 4000,
  "max_diff_bytes": 400000,
  "max_findings": 6,
  "max_findings_total": 12,
  "standards_files": [
    "projeto-geral.md"
  ],
  "rules": {
    "skip_draft": true,
    "pr_title_regex": null,
    "branch_regex": "^(feat|feature|fix|hotfix|refactor|chore|docs|test|release)/[a-z0-9._-]+",
    "commit_regex": null,
    "base_by_branch_prefix": {
      "feat": "integration",
      "feature": "integration",
      "fix": "integration",
      "refactor": "integration",
      "chore": "integration",
      "docs": "integration",
      "test": "integration",
      "perf": "integration",
      "hotfix": "default",
      "release": "default"
    },
    "min_description_chars": 40,
    "max_changed_files": null,
    "max_changed_lines": null,
    "warn_behind_commits": 30,
    "ignore_paths": [
      "^package-lock\\.json$",
      "^yarn\\.lock$",
      "^poetry\\.lock$",
      "\\.min\\.(js|css)$",
      "^dist/",
      "^build/"
    ],
    "forbidden_paths": [
      "^\\.env$",
      "\\.env\\.(local|production)$",
      "\\.pem$",
      "\\.p12$",
      "(^|/)id_rsa$",
      "(^|/)credentials\\.json$",
      "(^|/)serviceAccount.*\\.json$"
    ],
    "forbidden_diff_patterns": [
      {
        "name": "debug-leftover",
        "regex": "(?<!\\w)(console\\.log\\(|debugger;|pdb\\.set_trace|breakpoint\\(\\)|binding\\.pry)",
        "severity": "major",
        "skip_paths": [
          "(^|/)(tests?|spec|__tests__)/",
          "(^|/)test_[^/]*\\.py$",
          "_(test|spec)\\.(py|dart|ts|tsx|js)$",
          "\\.(test|spec)\\.[tj]sx?$",
          "(^|/)conftest\\.py$"
        ]
      },
      {
        "name": "test-focado",
        "regex": "(describe|it|test)\\.only\\(|(it|test)\\.skip\\(|@pytest\\.mark\\.skip",
        "severity": "major",
        "skip_paths": [
          "(^|/)(tests?|spec|__tests__)/",
          "(^|/)test_[^/]*\\.py$",
          "_(test|spec)\\.(py|dart|ts|tsx|js)$",
          "\\.(test|spec)\\.[tj]sx?$",
          "(^|/)conftest\\.py$"
        ]
      },
      {
        "name": "possivel-segredo",
        "regex": "(?i)(api[_-]?key|secret|password|passwd|token|authorization)\\s*[:=]\\s*[\"'][^\"'\\s$]{12,}[\"']",
        "severity": "blocker",
        "skip_paths": [
          "(^|/)(tests?|spec|__tests__)/",
          "(^|/)test_[^/]*\\.py$",
          "_(test|spec)\\.(py|dart|ts|tsx|js)$",
          "\\.(test|spec)\\.[tj]sx?$",
          "(^|/)conftest\\.py$"
        ]
      },
      {
        "name": "sql-concatenado",
        "regex": "(?i)(execute|executemany|raw|cursor\\.execute)\\s*\\(\\s*(f[\\\"']|[\\\"'][^\\\"']*[\\\"']\\s*(\\+|%(?!s)|\\.format\\()|\\w+\\s*\\+\\s*[\\\"'])",
        "severity": "blocker"
      },
      {
        "name": "print-em-producao",
        "regex": "^\\s*print\\(",
        "severity": "minor",
        "skip_paths": [
          "(^|/)(tests?|spec|__tests__)/",
          "(^|/)test_[^/]*\\.py$",
          "_(test|spec)\\.(py|dart|ts|tsx|js)$",
          "\\.(test|spec)\\.[tj]sx?$",
          "(^|/)conftest\\.py$"
        ]
      },
      {
        "name": "conflito-nao-resolvido",
        "regex": "^(<{7}|={7}$|>{7})( |$)",
        "severity": "blocker"
      },
      {
        "name": "url-hardcoded",
        "regex": "https?://(localhost|127\\.0\\.0\\.1|\\d+\\.\\d+\\.\\d+\\.\\d+)",
        "severity": "major"
      },
      {
        "name": "auth-desligada",
        "regex": "(?i)(permission_classes\\s*=\\s*\\[\\s*AllowAny|csrf_exempt|verify\\s*=\\s*False|rejectUnauthorized\\s*:\\s*false|@csrf_exempt)",
        "severity": "major",
        "skip_paths": [
          "(^|/)(tests?|spec|__tests__)/",
          "(^|/)test_[^/]*\\.py$",
          "_(test|spec)\\.(py|dart|ts|tsx|js)$",
          "\\.(test|spec)\\.[tj]sx?$",
          "(^|/)conftest\\.py$"
        ]
      },
      {
        "name": "comparacao-de-segredo-insegura",
        "regex": "(?i)(signature|hmac|token|secret)\\w*\\s*==\\s*",
        "severity": "major",
        "skip_paths": [
          "(^|/)(tests?|spec|__tests__)/",
          "(^|/)test_[^/]*\\.py$",
          "_(test|spec)\\.(py|dart|ts|tsx|js)$",
          "\\.(test|spec)\\.[tj]sx?$",
          "(^|/)conftest\\.py$"
        ]
      },
      {
        "name": "migracao-irreversivel",
        "regex": "RunPython\\([^,)]+\\)\\s*$|reverse_code\\s*=\\s*None",
        "severity": "major"
      },
      {
        "name": "delete-em-massa",
        "regex": "\\.objects\\.all\\(\\)\\.delete\\(\\)|\\.delete\\(\\)\\s*$|TRUNCATE |DROP TABLE",
        "severity": "major",
        "skip_paths": [
          "(^|/)(tests?|spec|__tests__)/",
          "(^|/)test_[^/]*\\.py$",
          "_(test|spec)\\.(py|dart|ts|tsx|js)$",
          "\\.(test|spec)\\.[tj]sx?$",
          "(^|/)conftest\\.py$"
        ]
      }
    ],
    "require_tests": null,
    "max_diff_hits_per_file": 3,
    "expert_checks": true,
    "detect_stacked_prs": true,
    "churn_file_threshold": 3
  }
}
